# Documentation only. The package does not load .env files automatically.
HARNESS_RESPONSES_URL=https://your-provider.example/v1/responses
HARNESS_MODEL=your-supported-model
HARNESS_MODEL_API_KEY=configure-in-process-environment
HARNESS_ALLOW_MODEL_EGRESS=1
# Required: actual USD prices per million tokens from your provider contract.
HARNESS_INPUT_PRICE_PER_MILLION=
HARNESS_OUTPUT_PRICE_PER_MILLION=
# Explicit capability selection: json_schema or json_object
HARNESS_MODEL_FORMAT=json_schema
