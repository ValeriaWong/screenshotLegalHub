  "components": {
    "schemas": {
      "FunctionCall": {
        "properties": {
          "type": {
            "type": "string",
            "const": "function_call",
            "title": "Type"
          },
          "call_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Call Id"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "arguments": {
            "type": "string",
            "maxLength": 65536,
            "title": "Arguments"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "in_progress",
                  "completed",
                  "incomplete"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "call_id",
          "name",
          "arguments"
        ],
        "title": "FunctionCall"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Limits": {
        "properties": {
          "max_iterations": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Iterations",
            "default": 24
          },
          "max_repairs": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Repairs",
            "default": 2
          },
          "max_tool_calls": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Max Tool Calls",
            "default": 32
          },
          "max_model_calls": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Max Model Calls",
            "default": 0
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Max Tokens",
            "default": 0
          },
          "max_cost": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Max Cost",
            "default": 0
          },
          "max_context_bytes": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 128.0,
            "title": "Max Context Bytes",
            "default": 1000000
          },
          "max_context_tokens": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 128.0,
            "title": "Max Context Tokens",
            "default": 1000000
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout Seconds",
            "default": 60
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Limits"
      },
      "ResumeRequest": {
        "properties": {
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "approve",
                  "reject"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "gate_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gate Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ResumeRequest"
      },
      "RunRequest": {
        "properties": {
          "workflow": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Workflow"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Idempotency Key"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workflow",
          "input",
          "idempotency_key"
        ],
        "title": "RunRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
