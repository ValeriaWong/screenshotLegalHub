# Copy to .env only when needed. Do not commit .env or real keys.
HOST=0.0.0.0
SESSION_HOURS=8
SESSION_SECURE_COOKIE=false
TRUSTED_ORIGINS=["http://127.0.0.1:18431","http://localhost:18431","http://127.0.0.1:18430","http://localhost:18430"]
# User model settings are stored through the UI; these legacy values are for offline adapters only.
ENABLE_REAL_MODEL=false
ALLOW_EXTERNAL_EGRESS=false
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
AUTO_APPROVE_GATES=false
MAX_UPLOAD_BYTES=20971520
MAX_BATCH_FILES=50
MAX_BATCH_BYTES=104857600
ALLOWED_MIME_TYPES=["image/png","image/jpeg","image/webp","application/pdf","text/plain"]

# HTTPS reverse proxy: dev-backend.ps1 / conda_workspace.py backend load .env.network when present.
# Set SESSION_SECURE_COOKIE=true and add the public HTTPS origin in that file.
