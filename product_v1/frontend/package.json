{
  "name": "screenshotlegal-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18431 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node tools/architecture-guard.mjs",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../artifacts/openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.66.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "typescript-eslint": "^8.24.0",
    "@eslint/js": "^9.20.0",
    "globals": "^15.15.0",
    "vitest": "^3.0.5",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@playwright/test": "^1.51.0",
    "@axe-core/playwright": "^4.10.1",
    "openapi-typescript": "^7.6.1"
  }
}
